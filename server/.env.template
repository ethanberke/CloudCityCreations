# Copy to server/.env. This is the server's only source of config — it no longer
# reads the repo-root .env, which also carried a GitHub PAT (#27).
#
# Values below are for running the server on the host (`npm run dev`) against a
# dockerised database. compose.yaml overrides POSTGRES_HOST and DATABASE_URL to
# the `db` service hostname for the containerised server, so one file serves both.

PORT=5000

# Where uploaded recipe photos are written. Relative paths resolve against the
# server directory, not the working directory.
UPLOAD_DIR=uploads

# The recipe importer (scraper/, a Python service). compose.yaml overrides this
# with the `scraper` service hostname; this value is for the server running on
# the host against the containerised importer.
SCRAPER_URL=http://localhost:8001

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgres://postgres:password@localhost:5432/mydb
