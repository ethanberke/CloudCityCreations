/node_modules/
/client/dist
/server/uploads/

# Every .env variant is ignored by default rather than listed one at a time —
# the previous `**/.env` matched only that exact name, so a new file like
# .env.tooling would have been committed. Templates are the one exception.
.env
.env.*
**/.env
**/.env.*
!.env.template
!**/.env.template

# Python (scraper/): local virtualenv, bytecode and tool caches. The service
# ships its dependencies through requirements.txt and its image, so none of
# this belongs in the repo.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
